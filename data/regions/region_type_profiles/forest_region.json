      "properties": ["water", "resource"],
      "affinity": ["river", "resource_rich"],
      "category": "resource",
      "allowed_sources": ["optional"],
      "allow_multiple": false
    },
    "hidden_grove": {
      "satisfies": ["landmark.memorable"],
      "role_tags": ["hidden", "landmark"],
      "properties": ["hidden", "landmark"],
      "affinity": ["forest", "has_hidden_places"],
      "category": "landmark",
      "allowed_sources": ["optional", "forced"],
      "allow_multiple": false
    },
    "forest_shrine": {
      "satisfies": ["ritual.place", "landmark.memorable"],
