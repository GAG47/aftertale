{
  "schema_version": 2,
  "region_type": "forest_region",
  "required_needs": [
    "travel.access",
    "wilderness.core",
    "wilderness.inner"
  ],
  "optional_needs": [
    "landmark.memorable",
    "shelter.local",
    "danger.local",
    "resource.water",
    "ritual.place"
  ],
  "scale_optional_counts": {
    "small": [1, 2],
    "medium": [2, 3],
    "large": [3, 4]
  },
  "role_weights": {
    "clearing": 0.9,
    "hut": 0.55,
    "ruin": 0.45,
    "stream": 0.65,
    "hidden_grove": 0.5,
    "forest_shrine": 0.35
  },
  "context_weight_modifiers": {
    "terrain_context": {
      "forest": {
        "clearing": 1.2,
        "hidden_grove": 1.3
      },
      "river_near": {
        "stream": 2.0,
        "clearing": 0.9
      },
      "plain": {
        "clearing": 1.4,
        "hidden_grove": 0.8
      }
    },
    "political_context": {
      "wilderness": {
        "hidden_grove": 1.4,
        "hut": 1.2
      },
      "border": {
        "ruin": 1.3,
        "hut": 1.1
      }
    }
  },
  "role_definitions": {
    "entrance": {
      "satisfies": ["travel.access", "boundary.frontier"],
      "role_tags": ["boundary", "forest", "travel"],
      "properties": ["access", "boundary"],
      "affinity": ["road_access", "frontier"],
      "category": "road",
      "allowed_sources": ["required"],
      "allow_multiple": false
    },
    "common_woods": {
      "satisfies": ["wilderness.core", "resource.forest"],
      "role_tags": ["common", "forest"],
      "properties": ["forest", "resource"],
      "affinity": ["forest", "resource_rich"],
      "category": "wilderness",
      "allowed_sources": ["required"],
      "allow_multiple": false
    },
    "inner_area": {
      "satisfies": ["wilderness.inner", "danger.local"],
      "role_tags": ["inner", "forest"],
      "properties": ["dangerous", "inner"],
      "affinity": ["forest", "dangerous"],
      "category": "wilderness",
      "allowed_sources": ["required"],
      "allow_multiple": false
    },
    "clearing": {
      "satisfies": ["landmark.memorable"],
      "role_tags": ["landmark", "open_area"],
      "properties": ["landmark"],
      "affinity": ["forest"],
      "category": "landmark",
      "allowed_sources": ["optional"],
      "allow_multiple": false
    },
    "hut": {
      "satisfies": ["shelter.local"],
      "role_tags": ["shelter", "npc_candidate"],
      "properties": ["shelter"],
      "affinity": ["wilderness", "frontier"],
      "category": "public",
      "allowed_sources": ["optional", "forced"],
      "allow_multiple": false
