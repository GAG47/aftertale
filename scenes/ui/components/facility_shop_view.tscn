[gd_scene format=3]

[node name="ShopView" type="VBoxContainer"]
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Intro" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Description" type="Label" parent="Intro"]
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 2

[node name="Money" type="Label" parent="Intro"]
layout_mode = 2

[node name="Modes" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="BuyButton" type="Button" parent="Modes"]
layout_mode = 2
toggle_mode = true
text = "购买"

[node name="SellButton" type="Button" parent="Modes"]
layout_mode = 2
toggle_mode = true
text = "出售"

[node name="Body" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3

[node name="ListPanel" type="PanelContainer" parent="Body"]
custom_minimum_size = Vector2(370, 0)
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Body/ListPanel"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Body/ListPanel/Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Body/ListPanel/Margin/Box"]
layout_mode = 2
text = "商品列表"

[node name="Scroll" type="ScrollContainer" parent="Body/ListPanel/Margin/Box"]
layout_mode = 2
size_flags_vertical = 3

[node name="OfferList" type="VBoxContainer" parent="Body/ListPanel/Margin/Box/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="DetailPanel" type="PanelContainer" parent="Body"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Margin" type="MarginContainer" parent="Body/DetailPanel"]
layout_mode = 2

[node name="DetailBox" type="VBoxContainer" parent="Body/DetailPanel/Margin"]
layout_mode = 2

